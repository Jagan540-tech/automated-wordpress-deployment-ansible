# Use this when you run Ansible from your laptop / another machine:
#   ansible-playbook -i inventory/hosts.ini site.yml
# Copy to inventory/hosts.ini (git-ignored), then replace the IP and the key path.
[webservers]
ec2 ansible_host=YOUR_EC2_PUBLIC_IP ansible_user=ec2-user ansible_ssh_private_key_file=~/keys/your-key.pem
