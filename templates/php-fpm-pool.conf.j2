; {{ ansible_managed }}
[{{ web_user }}]
user  = {{ web_user }}
group = {{ web_user }}

listen = /run/php-fpm/{{ web_user }}.sock
listen.owner = nginx
listen.group = nginx
listen.mode  = 0660

pm = dynamic
pm.max_children = 8
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 3

php_admin_value[error_log] = /var/log/php-fpm/{{ web_user }}-error.log
php_admin_flag[log_errors] = on
php_value[session.save_handler] = files
php_value[session.save_path]    = /var/lib/php/session-{{ web_user }}
